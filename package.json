{
  "name": "sanity-plugin-vimeo-sync",
  "version": "3.1.0",
  "description": "Sync Vimeo PRO videos into Sanity",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/tristantbg/sanity-plugin-vimeo-sync#readme",
  "bugs": {
    "url": "https://github.com/tristantbg/sanity-plugin-vimeo-sync/issues"
  },
  "license": "MIT",
  "author": "Tristan Bagot <hello@tristanbagot.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tristantbg/sanity-plugin-vimeo-sync.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "pnpm link-watch",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/color": "^3.0.8",
    "@sanity/icons": "^5.2.2",
    "@sanity/studio-secrets": "^4.0.19",
    "@sanity/ui": "^4.2.1",
    "hls-video-element": "^1.5.11",
    "media-chrome": "^4.19.2",
    "nanoid": "^6.0.1",
    "react-icons": "^5.7.0",
    "yalc": "1.0.0-pre.53"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.0",
    "@sanity/plugin-kit": "^10.0.9",
    "@types/react": "^19.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.13.2",
    "styled-components": "6.5.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2",
    "sanity": "^5 || ^6",
    "styled-components": "^6.1"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@12.4.1",
  "sanityPlugin": {
    "verifyPackage": {
      "eslintImports": false,
      "tsconfig": false
    }
  }
}
